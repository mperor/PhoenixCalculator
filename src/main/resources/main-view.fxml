<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="root" prefHeight="590" prefWidth="370" styleClass="content,calculator" stylesheets="@css/style.css"
          xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25"
          fx:controller="eu.mapidev.calculator.phoenix.MainController">

    <StackPane GridPane.columnSpan="4">
        <VBox prefHeight="140" styleClass="top">
            <Label fx:id="lblMemory" styleClass="memory" text="0"/>
            <Label fx:id="lblResult" styleClass="result" text="0"/>
        </VBox>
        <!-- Not direct GridPane children, so they stay out of the keyboard bindings -->
        <HBox StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity">
            <Button text="–" focusTraversable="false" styleClass="window-button" onAction="#handleMinimize"/>
            <Button text="×" focusTraversable="false" styleClass="window-button,close" onAction="#handleClose"/>
        </HBox>
    </StackPane>

    <Button text="\%" userData="\%" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="1" onAction="#handleInput"/>
    <Button text="+/-" userData="+/-" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" onAction="#handleInput"/>
    <Button text="C" userData="C" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="2" onAction="#handleInput"/>
    <Button text="/" userData="/" focusTraversable="false" style="-fx-font-size: 22px;" styleClass="operation" prefWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3" onAction="#handleInput"/>

    <Button text="7" userData="7" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="2" onAction="#handleInput"/>
    <Button text="8" userData="8" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" onAction="#handleInput"/>
    <Button text="9" userData="9" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="2" onAction="#handleInput"/>
    <Button text="x" userData="x" focusTraversable="false" style="-fx-font-size: 22px;" styleClass="operation" prefWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="3" onAction="#handleInput"/>

    <Button text="4" userData="4" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="3" onAction="#handleInput"/>
    <Button text="5" userData="5" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" onAction="#handleInput"/>
    <Button text="6" userData="6" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="2" onAction="#handleInput"/>
    <Button text="-" userData="-" focusTraversable="false" style="-fx-font-size: 38px;" styleClass="operation" prefWidth="Infinity" GridPane.rowIndex="3"
            GridPane.columnIndex="3" onAction="#handleInput"/>

    <Button text="1" userData="1" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="4" onAction="#handleInput"/>
    <Button text="2" userData="2" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1" onAction="#handleInput"/>
    <Button text="3" userData="3" focusTraversable="false" prefWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="2" onAction="#handleInput"/>
    <Button text="+" userData="+" focusTraversable="false" style="-fx-font-size: 28px;" styleClass="operation" prefWidth="Infinity" GridPane.rowIndex="4"
            GridPane.columnIndex="3" onAction="#handleInput"/>

    <Button text="0" userData="0" focusTraversable="false" style="-fx-background-radius: 0 0 0 5;" prefWidth="Infinity" GridPane.rowIndex="5" onAction="#handleInput"/>
    <Button text="," userData="," focusTraversable="false" style="-fx-font-size: 35px;" prefWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1" onAction="#handleInput"/>
    <Button text="=" userData="=" style="-fx-font-size: 35px;" styleClass="equality" prefWidth="Infinity" GridPane.rowIndex="5"
            GridPane.columnIndex="2" GridPane.columnSpan="2" onAction="#handleInput"/>

    <columnConstraints>
        <ColumnConstraints percentWidth="25"/>
        <ColumnConstraints percentWidth="25"/>
        <ColumnConstraints percentWidth="25"/>
        <ColumnConstraints percentWidth="25"/>
    </columnConstraints>
</GridPane>
